{% for part in geometry %}
{{ part.stl_file }}
{
    extractionMethod    extractFromSurface;

    includedAngle       150;

    subsetFeatures
    {
        nonManifoldEdges       no;

        openEdges       yes;
    }

    writeObj            yes;
}

{% endfor %}

