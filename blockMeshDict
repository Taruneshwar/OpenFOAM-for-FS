FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

scale   1;

bbox_xmin -8974.62;
bbox_ymin -2700;
bbox_zmin -177.298;
bbox_xmax 2970.29;
bbox_ymax 2700;
bbox_zmax 2985.03;

cell_size_mm 100;

xmin             #calc "$bbox_xmin - ( 2.123456789 * $cell_size_mm /100 )";
ymin             #calc "$bbox_ymin - ( 2.123456789 * $cell_size_mm /100 )";
zmin             #calc "$bbox_zmin - ( 2.123456789 * $cell_size_mm /100 )";
xmax             #calc "$bbox_xmax + ( 2.123456789 * $cell_size_mm /100 )";
ymax             #calc "$bbox_ymax + ( 2.123456789 * $cell_size_mm /100 )";
zmax             #calc "$bbox_zmax + ( 2.123456789 * $cell_size_mm /100 )";

lx               #calc "$xmax - $xmin";
ly               #calc "$ymax - $ymin";
lz               #calc "$zmax - $zmin";

xcells           #calc "round( $lx / $cell_size_mm )";
ycells           #calc "round( $ly / $cell_size_mm )";
zcells           #calc "round( $lz / $cell_size_mm )";

vertices
(
    ( $xmin  $ymin  $zmin )
    ( $xmax  $ymin  $zmin )
    ( $xmax  $ymax  $zmin )
    ( $xmin  $ymax  $zmin )
    ( $xmin  $ymin  $zmax )
    ( $xmax  $ymin  $zmax )
    ( $xmax  $ymax  $zmax )
    ( $xmin  $ymax  $zmax )
);

blocks
(
    hex (0 1 2 3 4 5 6 7) ( 50 20 20 ) simpleGrading (1 1 1)
);

